# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# Every setting is optional except a provider API key for your chosen model.

# --- Model & provider -------------------------------------------------------
# Any LiteLLM model string. Examples:
#   anthropic/claude-sonnet-4-6            (needs ANTHROPIC_API_KEY)
#   openai/gpt-4o                          (needs OPENAI_API_KEY)
#   gemini/gemini-1.5-pro                  (needs GEMINI_API_KEY)
#   openrouter/anthropic/claude-sonnet-4-6 (needs OPENROUTER_API_KEY)
#   ollama_chat/llama3                     (local Ollama, no key)
DP_CORE_MODEL=anthropic/claude-sonnet-4-6
DP_MAX_TOKENS=2048

# --- Model routing (optional, off by default) --------------------------------
# Hand each conversational turn to an OpenRouter router, which picks the model
# per request (needs OPENROUTER_API_KEY). Jev Router judges each request's
# difficulty and also picks the reasoning effort; openrouter/openrouter/auto
# (the Auto Router) is supported too. If the router itself fails, the turn
# falls back to DP_CORE_MODEL. Which model served each request is shown in
# OpenRouter's Activity page.
# DP_ROUTER_MODEL=openrouter/typesafe/jev-router
# low | medium | high. Unset = the router's default policy (or your account
# defaults at openrouter.ai/settings/routing).
# DP_ROUTER_COST_TIER=medium
# Comma-separated slugs or patterns. Jev treats DP_ROUTER_MODELS as a
# preference and falls back to other models when none of them can serve a
# request; DP_ROUTER_EXCLUDED is always enforced.
# DP_ROUTER_MODELS=anthropic/*,google/*
# DP_ROUTER_EXCLUDED=anthropic/claude-opus*
# Internal strict-JSON jobs (consolidation, fact reconciliation) and idle
# check-ins are pinned, never routed. Defaults to DP_CORE_MODEL. Point it at a
# stronger model if consolidation is producing unparseable JSON.
# DP_UTILITY_MODEL=

# Cap on the episodic log; it is trimmed to the most recent N entries (0 disables).
DP_MAX_EPISODES=2000
# Facts whose salience decays below this are forgotten on consolidation (0 disables).
DP_SALIENCE_FLOOR=0.05

# Provider API key (set the one matching DP_CORE_MODEL).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# One OpenRouter key reaches models from every provider it proxies, so an
# openrouter/* model needs only this key regardless of who made the model.
# OPENROUTER_API_KEY=

# Optional: custom endpoint for DP_CORE_MODEL (e.g. Ollama Cloud, a proxy).
# DP_API_KEY falls back to OLLAMA_CLOUD_API_KEY if set.
# NOTE: this pair describes ONE endpoint, so it is applied to DP_CORE_MODEL
# only. Models called with an explicit override take their credentials from
# their own provider key above instead.
# DP_API_BASE=
# DP_API_KEY=
# OLLAMA_CLOUD_API_KEY=

# --- Web access -------------------------------------------------------------
# `web_search` and `fetch_url` let the agent research the live web. Search works
# with no key via DuckDuckGo; set a key below for a higher-quality provider.
# DP_SEARCH_PROVIDER: auto (default) | duckduckgo | tavily | brave
# DP_SEARCH_PROVIDER=auto
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Result/size limits for the web tools.
# DP_WEB_MAX_RESULTS=5
# DP_WEB_MAX_CHARS=8000
# DP_WEB_TIMEOUT=20

# --- Runtime data -----------------------------------------------------------
# Where memory, audit log, vector index and sandbox workspace are stored.
# Defaults to $XDG_DATA_HOME/paulus (i.e. ~/.local/share/paulus).
# DP_DATA_DIR=/var/lib/paulus

# --- Proactive (idle) outreach ----------------------------------------------
# Idleness is tracked per user. When a user has been quiet for DP_MIN_IDLE
# minutes, the agent may send an unprompted check-in (it can also stay silent).
# How often (seconds) to scan for idle users. 0 disables proactive outreach.
DP_IDLE_CHECK=300
# Minutes of silence before a user becomes eligible for a nudge.
DP_MIN_IDLE=30
# Max unprompted messages per user before they speak again (resets on reply).
DP_MAX_IDLE_MSG=3
# Local-time quiet window (24h, START-END) during which no nudges are sent;
# wraps midnight if START > END. Empty disables. e.g. 23-7 mutes 23:00–07:00.
# DP_QUIET_HOURS=23-7

# --- Sandbox ----------------------------------------------------------------
# Command/file execution backend: local | docker | ssh
DP_SANDBOX=local
DP_CMD_TIMEOUT=30
# DP_DOCKER_IMAGE=python:3.12-slim
# DP_SSH_TARGET=user@host
# DP_SSH_REMOTE_DIR=~/dp-workspace

# --- Safety -----------------------------------------------------------------
# What to do with a high-impact action (write file / run command / send
# message) when no one can be asked to approve it (e.g. running as a service
# with no reachable user): deny (default, fail safe) | approve
DP_UNATTENDED_POLICY=deny
# Let a reachable, trusted gateway user approve high-impact actions
# interactively (Telegram Approve/Deny buttons) instead of falling straight to
# the policy above. On by default; set to 0 to disable. Unanswered prompts time
# out to a safe DENY after DP_APPROVAL_TIMEOUT seconds.
# DP_GATEWAY_APPROVALS=1
# DP_APPROVAL_TIMEOUT=300
# Auto mode: a reviewer model approves high-impact actions the owner clearly
# asked for and only prompts for the rest (flagged ones show its concern). It
# sees the owner's words and the actions, never fetched/document content. It
# only acts for someone who could have approved the prompt themselves, and any
# reviewer failure falls back to the prompt. ask (default) | auto
# DP_PERMISSION_MODE=ask
# The reviewer's model (default: DP_CORE_MODEL). Use a capable one: its
# mistakes are approvals.
# DP_AUTO_MODEL=
# Or review with TypeSafe's Jev, a classifier returning calibrated
# probabilities (fast and cheap; early access). An action is approved only if
# Jev is >= DP_JEV_THRESHOLD sure the owner asked for it AND that sure it isn't
# risky; anything in between goes to the owner's prompt.
# Via OpenRouter (uses your OPENROUTER_API_KEY):
# DP_AUTO_MODEL=openrouter/typesafe/jev-latest
# Or direct from TypeSafe:
# DP_AUTO_MODEL=typesafe/jev-latest
# TYPESAFE_API_KEY=
# DP_JEV_THRESHOLD=0.9
# DP_AUTO_TIMEOUT=10

# --- Subagents & background tasks --------------------------------------------
# Subagents: the agent can `delegate` self-contained subtasks to parallel
# researcher/worker subagents (clean context, short tool list, step budget).
# Their high-impact actions go through the same approval gate. 0 disables.
# DP_SUBAGENTS=1
# Unset = the model the turn was routed to.
# DP_SUBAGENT_MODEL=
# DP_SUBAGENT_MAX_STEPS=15
# DP_SUBAGENT_MAX_PARALLEL=4
# Background tasks: long jobs run beside the conversation (`start_task`, /bg)
# and report back as their own message. In-memory: a restart drops them. In
# the terminal they can't prompt, so actions needing approval are denied
# unless auto mode or an "allow for this task" grant covers them. 0 disables.
# DP_TASKS=1
# Unset = the model the turn was routed to.
# DP_TASK_MODEL=
# DP_TASK_MAX_STEPS=40
# DP_TASK_MAX_MINUTES=30
# DP_MAX_TASKS_PER_USER=3

# --- MCP servers (needs the `mcp` extra) --------------------------------------
# Server list in Claude Desktop's "mcpServers" format; absent = no MCP tools.
# ${VAR} in it is read from this environment, so tokens can live here.
# DP_MCP_CONFIG=~/.local/share/paulus/mcp.json
# DP_MCP_CONNECT_TIMEOUT=30
# DP_MCP_CALL_TIMEOUT=60
# DP_MCP_MAX_CHARS=12000
# GITHUB_TOKEN=ghp_...

# --- Billing (usage pay gate) ------------------------------------------------
# Optional. Balance, transactions and per-message pricing all live in an
# external billing service. When set, gateway users are checked against it
# before each LLM turn and blocked once their balance runs out; CLI /
# single-owner mode is never gated. Unset (default) = gate disabled.
# DP_BILLING_API_BASE=https://payment.example.com/paulus
# DP_BILLING_CHECK_PATH=/usage/check
# DP_BILLING_API_KEY=
# DP_BILLING_TIMEOUT=10
# Fallback top-up link shown as a button with the insufficient-balance message
# (Telegram; other adapters append it as a plain URL) when the check-usage
# response doesn't include its own "payment_url". "{user_id}" is substituted
# if present. Unset = no link/button when the response doesn't supply one.
# DP_BILLING_TOPUP_URL=https://payment.example.com/paulus/topup?user={user_id}

# --- Telegram gateway (only needed for `paulus-gateway`) --------------------
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Who may CHAT with the bot: comma-separated numeric Telegram user IDs.
# Empty/unset = everyone. Non-listed users are turned away.
# TELEGRAM_ALLOWED_USERS=123456789,987654321
# Who may APPROVE high-impact actions (write file / run command / send message).
# Use this to keep the chat open to all but restrict high-impact actions to a
# few trusted IDs. Unset = same as TELEGRAM_ALLOWED_USERS; set but empty = nobody
# can approve (high-impact actions then follow DP_UNATTENDED_POLICY).
# TELEGRAM_TRUSTED_USERS=123456789
# Outbound formatting: MarkdownV2 (default) renders the model's Markdown;
# set to plain/none/off for raw text. Markdown needs the `telegram` extra.
# TELEGRAM_PARSE_MODE=MarkdownV2
# Stream replies by live-editing one message as the model writes (default on).
# Set to 0/off for one-shot delivery once the full reply is ready.
# TELEGRAM_STREAMING=1

# --- Web UI (part of `paulus-gateway`; needs the `webui` extra) ---------------
# A browser chat served by the gateway. Setting WEB_PORT turns it on. Users sign
# in with Telegram (so TELEGRAM_BOT_TOKEN is required, and TELEGRAM_ALLOWED_USERS
# / TELEGRAM_TRUSTED_USERS apply); a web user shares memory with their Telegram
# chat. Put it behind a TLS reverse proxy, and link the site's domain to the bot
# once with @BotFather -> /setdomain, or the login widget won't load.
# WEB_PORT=8080
# Interface to listen on. Keep the default when a proxy on the same host fronts it.
# WEB_HOST=127.0.0.1
# The public address. Logins and sockets must come from this origin; unset =
# the request's Host header (the proxy must then forward Host). Include the path
# when a proxy mounts the UI under one (e.g. on a domain shared with another
# site): the session cookie is then scoped to that path.
# WEB_PUBLIC_URL=https://paulus.example.com
# WEB_PUBLIC_URL=https://example.com/chat
# The bot's @username for the login widget. Unset = asked from Telegram at start.
# TELEGRAM_BOT_USERNAME=PaulusAIBot
# How long a web sign-in lasts.
# WEB_SESSION_DAYS=30
# Key that signs session cookies. Unset = derived from TELEGRAM_BOT_TOKEN, so
# rotating the token (or setting this) signs everyone out.
# WEB_SESSION_SECRET=
# Largest uploaded text document, in bytes.
# WEB_DOC_MAX_BYTES=262144
